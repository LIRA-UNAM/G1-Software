<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>surge_et_ambula</name>
  <version>0.0.0</version>
  <description>Top-level launch for the G1 getup ("rise and walk") stack: low-level bridge, getup policy and the e-stop / live-parameter web GUI, plus the motion recorder.</description>
  <maintainer email="garcia.miguel.onate@gmail.com">Miguel Garcia</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>getup</exec_depend>
  <exec_depend>getup_gui</exec_depend>
  <exec_depend>motion_recorder</exec_depend>
  <exec_depend>motion_recorder_gui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
