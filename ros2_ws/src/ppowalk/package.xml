<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ppowalk</name>
  <version>0.0.0</version>
  <description>Runs mjlab-trained velocity-tracking (walking) ONNX policies on the 23-DoF Unitree G1 through getup's g1_lowlevel_bridge, with an IMU upright gate and a slow home move.</description>
  <maintainer email="garcia.miguel.onate@gmail.com">Miguel Garcia</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>getup</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
